# ---------- Local use (stdio: Claude Code, Claude Desktop, Codex on this machine) ----------
# Token from https://api.indiankanoon.org/ (sent as "Authorization: Token <value>")
IK_API_TOKEN=
# Daily spend cap in INR. 0 = no cap. Resets at midnight IST.
IK_DAILY_BUDGET_INR=50

# ---------- Hosted use (MCP_TRANSPORT=http) ----------
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
PORT=3000
# Public base URL used in links shown to users, e.g. https://kanoon.example.com
PUBLIC_URL=
# Required for http: encrypts stored Indian Kanoon tokens and signs download links. `openssl rand -hex 32`
SECRET_KEY=
# Optional: lets the owner create keys that spend from IK_API_TOKEN (the server's own token). `openssl rand -hex 24`
ADMIN_TOKEN=
# Anyone can create a key with their own Indian Kanoon token
PUBLIC_SIGNUP=true
# Combined daily cap for all keys that use the server's own token
HOUSE_DAILY_BUDGET_INR=200
# Default daily cap for new keys
KEY_DEFAULT_BUDGET_INR=50
# Serve cached documents to all keys, whichever key fetched them first
IK_SHARE_CACHE=true
RATE_LIMIT_PER_MIN=120
# Keys database, ledgers (and cache unless IK_CACHE_DIR is set)
DATA_DIR=

# ---------- Shared tuning ----------
IK_MAX_PAGES_PER_SEARCH=5
IK_ENABLE_ORIGDOC=true
IK_CACHE_MAX_MB=500
IK_TTL_SEARCH_S=86400
IK_TTL_DOC_S=2592000
IK_TTL_META_S=604800
IK_TTL_FRAGMENT_S=2592000
IK_TIMEOUT_MS=30000
IK_MAX_RETRIES=3
IK_CONCURRENCY=4
LOG_LEVEL=info
